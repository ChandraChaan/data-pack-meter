#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing: never commit these (back them up somewhere safe instead)
/android/key.properties
/android/keystore/
*.jks
*.keystore

# Local screenshots and scratch output
/build_release/
/tool/screenshots/out/

# Generated by `flutter gen-l10n` (runs on `flutter pub get`)
/lib/l10n/app_localizations*.dart
